<form class="{{cssClass}}" autocomplete="off">
	<div class="sheet-wrapper">
		<div class="sheet-header">
			<div class="sheet-header__fields flexrow">
				<label for="name">{{localize "WWW.Move.Header"}}</label>
				<input class="input--title" name="name" id="name" type="text" value="{{item.name}}" placeholder="Name"/>
			</div>
		</div>

		<div class="cell cell--input">
			<label for="description">{{localize "WWW.Generic.Description"}}</label>
			<textarea name="system.description" id="description">{{item.system.description}}</textarea>
		</div>
		<div class="cell cell--input">
			<label for="stat">{{localize "WWW.Move.Roll"}}</label>
			<select name="system.stat" id="stat">
				{{selectOptions statChoices selected=item.system.stat localize=true}}
			</select>
		</div>

		<div class="cell cell--input">
			<label for="onSuccess">{{localize "WWW.Move.OnSuccess"}}</label>
			<textarea name="system.onSuccess" id="onSuccess">{{item.system.onSuccess}}</textarea>
		</div>
		<div class="cell cell--input">
			<label for="onMixed">{{localize "WWW.Move.OnMixed"}}</label>
			<textarea name="system.onMixed" id="onMixed">{{item.system.onMixed}}</textarea>
		</div>
		<div class="cell cell--input">
			<label for="onBotch">{{localize "WWW.Move.OnBotch"}}</label>
			<textarea name="system.onBotch" id="onBotch">{{item.system.onBotch}}</textarea>
		</div>

	</div>
</form>
